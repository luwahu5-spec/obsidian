+    /// <summary>
+    /// Works out what happened after a create-user request that got no response. The
+    /// pre-create lookup in <see cref="MigrateUser"/> already proved no user with this username
+    /// existed, so exactly one match now can only be the one this request created.
+    /// </summary>
+    /// <returns>
+    /// The original failure when Keycloak holds no such user (nothing to clean up); otherwise a
+    /// <see cref="KcUserCreationUncertainException"/>, carrying the created ID when it was found.
+    /// </returns>
+    private async Task<Exception> ResolveUncertainCreationAsync(Uri exactUserSearchUri, string userName, Exception cause)
+    {
+        try
+        {
+            var lookup = await TryCall(() => client.GetAsync(exactUserSearchUri), "GetUncertainCreatedUser", userName);
+            if (lookup.StatusCode == HttpStatusCode.OK)
+            {
+                var matches = await lookup.Content.ReadFromJsonAsync<List<KcUser>>();
+                if (matches != null && matches.Count == 0)
+                {
+                    return cause;
+                }
+
+                if (matches?.Count == 1)
+                {
+                    _logger.LogWarning(
+                        "Create request for {UserName} got no response, but Keycloak holds user {UserId}; returning it for rollback.",
+                        userName, matches[0].Id);
+                    return new KcUserCreationUncertainException(userName, matches[0].Id, cause);
+                }
+            }
+        }
+        catch (Exception lookupFailure)
+        {
+            _logger.LogError(lookupFailure,
+                "Could not determine whether Keycloak created user {UserName} after the create request failed.",
+                userName);
+        }
+
+        return new KcUserCreationUncertainException(userName, null, cause);
+    }
