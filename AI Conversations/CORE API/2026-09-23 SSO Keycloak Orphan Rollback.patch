+/// <summary>
+/// A create-user request reached Keycloak, or may have, but the call did not complete cleanly.
+/// Thrown instead of the underlying failure so the caller can remove the Keycloak identity
+/// during rollback rather than leaving an orphan that blocks every retry with "already exists".
+/// </summary>
+public class KcUserCreationUncertainException : KcClientException
+{
+    public KcUserCreationUncertainException(string userName, Guid? createdUserId, Exception innerException)
+        : base((innerException as KcClientException)?.HttpStatusCode ?? HttpStatusCode.GatewayTimeout,
+               "Keycloak user creation did not complete cleanly.",
+               innerException)
+    {
+        UserName = userName;
+        CreatedUserId = createdUserId;
+    }
+
+    public string UserName { get; }
+
+    /// <summary>
+    /// The Keycloak user that was created, when it could be identified. Null means an identity
+    /// may exist in Keycloak but could not be found, so rollback cannot be confirmed.
+    /// </summary>
+    public Guid? CreatedUserId { get; }
+
+    public override string Message => CreatedUserId.HasValue
+        ? $"Keycloak created user {UserName} ({CreatedUserId}) but the request did not complete cleanly."
+        : $"Keycloak may have created user {UserName}, but it could not be identified. Manual reconciliation may be required.";
 }
